# ===== App =====
APP_NAME=CareerPilot

# ===== Auth =====
# Set to "true" in production. When "false", fingerprint-based auth is used (dev only).
AUTH_ENABLED=false
# Generate a strong secret: `openssl rand -base64 48` (min 32 chars in production)
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
# Use "postgresql" in production. "sqlite" is dev-only.
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/careerpilot.db

# ===== AI Credentials =====
# Master key for encrypting AI provider credentials at rest.
# Must be different from AUTH_SECRET. Required in production (min 32 chars).
AI_CREDENTIAL_MASTER_KEY=

# ===== Bootstrap =====
# Email of the user to grant super_admin role at startup.
# The user must already exist in the database (registered via OAuth or email OTP).
# If unset in production, startup will warn but continue without a super admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ===== Backup =====
# Set to "true" in production. Enables daily encrypted PostgreSQL backups.
BACKUP_ENABLED=false
# Isolated storage location (separate volume/mount from the DB node).
BACKUP_DESTINATION=
# Retention period in days (backups older than this are pruned).
BACKUP_RETENTION_DAYS=7
# Email of the person responsible for backups (notified on failure).
BACKUP_OWNER_EMAIL=
# AES-256-GCM encryption key (min 32 chars). Must differ from AUTH_SECRET and AI_CREDENTIAL_MASTER_KEY.
BACKUP_ENCRYPTION_KEY=
# Schedule: "daily" or "hourly" (minimum frequency).
BACKUP_SCHEDULE=daily

# ===== Operations =====
# Alert when the 24-hour AI failure rate reaches this percentage.
OPS_ALERT_FAILURE_RATE_PERCENT=10
# Alert when net 24-hour AI consumption reaches this many credits.
OPS_ALERT_DAILY_CREDITS=10000
# Optional estimated provider cost per consumed credit. Leave empty to hide cost estimates.
AI_COST_PER_CREDIT=

# ===== i18n =====
DEFAULT_LOCALE=zh

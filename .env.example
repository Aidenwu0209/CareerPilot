# ===== App =====
APP_NAME=CareerPilot
# Public canonical URL used in Stripe redirect URLs (no trailing slash).
APP_URL=http://localhost:3000

# ===== Auth =====
# Product mode is the default. Demo identities exist only when this is explicitly true.
DEMO_MODE=false
# Generate a strong secret: `openssl rand -base64 48` (min 32 chars in production)
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
# Use "postgresql" in production. "sqlite" is dev-only.
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot
# Pool sizes must be coordinated with the database provider's connection limit.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_MAX_LIFETIME_SECONDS=1800
# prefer | require | verify-full | disable (verify-full is recommended for remote production DBs)
DATABASE_SSL_MODE=prefer

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/careerpilot.db

# Redis-backed cross-instance rate limiting. In multi-instance production,
# configure REDIS_URL and set RATE_LIMIT_DISTRIBUTED_REQUIRED=true.
REDIS_URL=
RATE_LIMIT_DISTRIBUTED_REQUIRED=false
# Shared career catalog cache. Values are bounded to 60-86400 seconds.
CACHE_TTL_OCCUPATIONS=600
CACHE_TTL_OCCUPATION_DETAIL=900

# ===== AI Credentials =====
# Master key for encrypting AI provider credentials at rest.
# Generate with `openssl rand -base64 48`. Set this before saving a provider
# credential, then keep it stable across restarts. It must differ from
# AUTH_SECRET and is required in production (min 32 chars).
AI_CREDENTIAL_MASTER_KEY=
# Comma-separated extra provider/upscaler hostnames. Never add private IPs.
AI_UPSTREAM_ALLOWED_DOMAINS=

# ===== ToC Billing (Stripe) =====
# Enable only after the secret key and signed webhook endpoint are configured.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== 4K Image Delivery =====
# GPT's 4K product tier uses native GPT generation followed by this dedicated upscaler.
IMAGE_4K_ENABLED=false
IMAGE_UPSCALER_API_KEY=

# ===== Bootstrap =====
# Email of the user to grant super_admin role at startup.
# The user must already exist in the database (registered with password, OAuth, or email code).
# If unset in production, startup will warn but continue without a super admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ===== Backup =====
# Set to "true" in production. Enables daily encrypted PostgreSQL backups.
BACKUP_ENABLED=false
# Isolated storage location (separate volume/mount from the DB node).
BACKUP_DESTINATION=
# Retention period in days (backups older than this are pruned).
BACKUP_RETENTION_DAYS=7
# Email of the person responsible for backups (notified on failure).
BACKUP_OWNER_EMAIL=
# AES-256-GCM encryption key (min 32 chars). Must differ from AUTH_SECRET and AI_CREDENTIAL_MASTER_KEY.
BACKUP_ENCRYPTION_KEY=
# Schedule: "daily" or "hourly" (minimum frequency).
BACKUP_SCHEDULE=daily

# ===== Operations =====
# Structured application log threshold: debug | info | warn | error
LOG_LEVEL=info
# Docker Compose JSON log rotation (per container).
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
# Alert when the 24-hour AI failure rate reaches this percentage.
OPS_ALERT_FAILURE_RATE_PERCENT=10
# Alert when net 24-hour AI consumption reaches this many credits.
OPS_ALERT_DAILY_CREDITS=10000
# Optional estimated provider cost per consumed credit. Leave empty to hide cost estimates.
AI_COST_PER_CREDIT=

# ===== APM / External Alerts / On-call =====
APM_ENABLED=false
OTEL_SERVICE_NAME=careerpilot-web
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional exporter headers, e.g. Authorization=Bearer token
OTEL_EXPORTER_OTLP_HEADERS=
EXTERNAL_ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
# HMAC-SHA256 signs webhook payloads when set.
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MS=300000
ONCALL_EMAILS=
# Protects /api/internal/monitoring/check and /api/internal/billing/reconcile.
CRON_SECRET=

# Optional. Configure SMTP to enable email-code login and on-call notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== i18n =====
DEFAULT_LOCALE=zh
